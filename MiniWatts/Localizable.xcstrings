            "state": "translated",
            "value": "%@ W vào cell pin"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld samples": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个样本"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mẫu"
          }
        }
      }
    },
    "%lld sensors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个传感器"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cảm biến"
          }
        }
      }
    },
    "%lld%%": {
      "shouldTranslate": false
    },
    "%lld%% → %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld%% → %2$lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% → %2$lld%%"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld%% → %2$lld%%"
          }
        }
      }
    },
    "%lld%% of adapter": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占适配器 %lld%%"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% công suất củ sạc"
          }
        }
      }
    },
    "°C": {
      "shouldTranslate": false
    },
    "46+": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "46+"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "46+"
          }
        }
      }
    },
    "A charge session survives the app being backgrounded: it ends when you unplug, not when you switch away. Any stretch the app missed is left out of the totals rather than estimated, and the session says how much of itself was actually measured.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切到后台不会结束一次充电记录：记录在拔掉充电器时才结束，而不是在你切走时。应用没看到的那段时间会从总量中排除，而不是估算补上；每条记录都会注明其中有多少是真正测到的。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phiên sạc vẫn tiếp tục khi ứng dụng chuyển xuống nền: nó chỉ kết thúc khi bạn rút sạc, không phải khi bạn chuyển ứng dụng. Bất kỳ khoảng thời gian nào ứng dụng bị lỡ sẽ bị loại trừ khỏi tổng số thay vì ước tính, và phiên sạc sẽ ghi rõ thời lượng thực tế được đo."
          }
        }
      }
    },
    "A session starts when you plug in and is saved when you unplug. Energy is integrated from the live sensors, so keep MiniWatts in the foreground for the totals to cover the whole charge.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插入充电器时开始记录会话，拔出时自动保存。电量数据由实时传感器积分计算得出，因此请将 MiniWatts 保持在前台运行，以确保完整记录整个充电过程。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phiên bắt đầu khi bạn cắm sạc và được lưu khi bạn rút sạc. Năng lượng được tích phân từ các cảm biến thời gian thực, vì vậy hãy giữ MiniWatts ở chế độ tiền cảnh để ghi lại toàn bộ quá trình sạc."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giới thiệu"
          }
        }
      }
    },
    "Above 80% the charger tapers to constant-voltage, so low draw here is normal battery chemistry, not a weak charger.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 80% 后充电转入恒压涓流阶段，此时功率偏低是正常的电池特性，不是充电器不行。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên 80%, quá trình sạc chuyển dần sang điện áp không đổi (sạc nhỏ giọt), vì vậy công suất rút thấp ở giai đoạn này là đặc tính hóa học bình thường của pin, không phải do củ sạc yếu."
          }
        }
      }
    },
