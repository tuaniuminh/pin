          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy cảm biến nhiệt độ nào. Trình giả lập không có; trên thiết bị thật, các cảm biến sẽ xuất hiện ngay sau khi ứng dụng đọc danh sách dịch vụ HID."
          }
        }
      }
    },
